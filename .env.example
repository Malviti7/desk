# Copy to .env and fill in. Everything is optional except where noted.

# FRED (free): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Hyperliquid: your public wallet address (read-only, no keys needed)
HYPERLIQUID_ADDRESS=

# Coinbase Advanced Trade (create a VIEW-ONLY key at https://portal.cdp.coinbase.com)
COINBASE_API_KEY=
COINBASE_API_SECRET=

# SEC EDGAR requires a contact in the User-Agent (free)
SEC_USER_AGENT="Your Name your@email.com"

# Telegram alerts (optional). Create a bot with @BotFather, then get your chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# TradingView webhook secret (any long random string). It goes in the webhook URL because
# TradingView can't send auth headers: https://<host>/api/webhooks/tradingview/<secret>
TV_WEBHOOK_SECRET=

# API protection. Leave blank for localhost-only use; set it if you expose the server.
DESK_API_TOKEN=

# Where the MCP server finds the Desk API
DESK_URL=http://127.0.0.1:8765
